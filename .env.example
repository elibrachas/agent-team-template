# =========================================================
# agent-team-template — environment TEMPLATE (core, compartido entre proyectos)
# =========================================================
# Este archivo SE VERSIONA. Solo placeholders, NUNCA valores reales.
# En el server, cópialo a .env.server (gitignored) y complétalo ahí.
# Comentarios SIEMPRE en su propia línea: el loader de los wrappers no corta un "# …" al final
# de un valor, y lo exportaría como parte del valor.
# Lo PROJECT-SCOPED (Supabase, GA4/GSC, Stripe, CMS, MySQL, Discord...) va en
# .env.<slug> — ver .env.acme.example.
#
# Alternativa para tu máquina (no para el server): 1Password + age con
# .env.local.tpl (referencias op://) y `node scripts/op-env.mjs exec -- <cmd>`.
# Ver docs/secretos.md.
# =========================================================

# --- Claude / Anthropic ---
# Los wrappers quitan ANTHROPIC_API_KEY del env para correr contra la suscripción
# (login OAuth de `claude login`). Déjala solo si quieres volver a billing por API.
ANTHROPIC_API_KEY=
# Perfil del usuario Windows que corrió `claude login` (cuando n8n corre como SYSTEM).
# ej. C:\Users\<usuario>
CLAUDE_USERPROFILE=

# --- Modelo y límites de presupuesto (backstop; el guard real es el timeout) ---
ANTHROPIC_MODEL=claude-sonnet-4-6
DAILY_BUDGET_USD=20
PER_RUN_BUDGET_USD=3
AGENT_TIMEOUT_MINUTES=30

# --- GitHub (Cody / Alfred abren PRs headless) ---
GH_TOKEN=

# --- Slack (canal de notificaciones HITL, opcional) ---
SLACK_BOT_TOKEN=
SLACK_CHANNEL_AGENTS=#agent-team
SLACK_CHANNEL_ALERTS=#agent-team-alerts

# =========================================================
# Supabase — DB de producción del producto (read-only para los agentes)
# =========================================================
# Modelo de keys nuevo (sb_publishable_* / sb_secret_*, reemplazan anon/service_role).
# Las skills de data usan la SECRET key SOLO para reportes agregados (counts/sums),
# NUNCA para extraer PII individual.
# https://your-project-ref.supabase.co
SUPABASE_URL=
# sb_publishable_... (cliente, equivale a anon)
SUPABASE_PUBLIC_KEY=
# sb_secret_...      (agregadas, equivale a service_role)
SUPABASE_AGENTS_KEY=
# Para el MCP oficial de Supabase (npx @supabase/mcp-server-supabase, modo --read-only).
# Normalmente van en .env.<slug> (project-scoped):
# your-project-ref
SUPABASE_PROJECT_REF=
# Personal Access Token de Supabase (solo para el MCP)
SUPABASE_ACCESS_TOKEN=
# Connection string Postgres directo (opcional, para queries pesadas / MCP postgres):
# postgres://postgres.<ref>:<password>@<host>:6543/postgres?sslmode=require
DATABASE_URL=
# Si se configura una réplica read-only para analytics, apuntar aquí:
DATABASE_URL_READONLY=

# =========================================================
# Pagos (read-only para los agentes; normalmente project-scoped)
# =========================================================
# rk_live_... restricted key SOLO lectura
STRIPE_RESTRICTED_KEY=

# =========================================================
# Analytics — Google (GA4 + Search Console comparten service account)
# =========================================================
# API key de Google (CrUX / PageSpeed)
GOOGLE_API=
# agents@your-gcp-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# --- GA4 ---
# YOUR_GA4_PROPERTY_ID
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_JSON_PATH=./secrets/ga4-sa.json

# --- Vercel (MCP read-only scripts/mcp-vercel: deploys + build logs + errores de runtime) ---
# CORE: va UNA vez aquí (.env.server), no en cada .env.<slug>. Es un token de la cuenta con
# alcance a todo el team: Vercel no tiene tokens read-only, el solo-lectura lo impone el MCP
# (solo GET + pin de proyectos por project.json → vercel, que el wrapper exporta como
# VERCEL_TEAM_ID / VERCEL_PROJECTS: no los cargues a mano). El nombre de la variable es
# VERCEL_API_TOKEN a propósito: el CLI de Vercel toma VERCEL_TOKEN del entorno y dejaría a
# cualquier agente con Bash autenticado para deployar o borrar. Detalle: docs/vercel-readonly-source.md.
VERCEL_API_TOKEN=
# Solo para una corrida local sin wrapper (un único proyecto). En el server NO hace falta.
VERCEL_PROJECT_ID=

# =========================================================
# Paid acquisition (opcional)
# =========================================================
# --- Google Ads (MCP oficial read-only, docs/google-ads-readonly-source.md) ---
# Sin secreto propio: autentica con la key JSON de la service account de GA4
# (GA4_SERVICE_ACCOUNT_JSON_PATH). Sin developer token (Google los dio de baja): no lo cargues.
# El customer ID no lo lee el servidor MCP: va escrito en los overrides de Numa y Greta.
# El login customer ID solo hace falta si entras por una cuenta de administrador (MCC).
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# NO setees GOOGLE_ADS_MCP_OAUTH_CLIENT_ID / GOOGLE_ADS_MCP_OAUTH_CLIENT_SECRET: pasan el MCP a HTTP.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# =========================================================
# SEO tooling
# =========================================================
# --- Google Search Console (usa el mismo service account de arriba) ---
GSC_SITE_URL=https://acme.example/
GSC_SERVICE_ACCOUNT_JSON_PATH=./secrets/ga4-sa.json

# --- Ahrefs (opcional) ---
AHREFS_API_TOKEN=

# =========================================================
# PM & docs
# =========================================================
# --- Linear (tickets / specs) ---
# API key: Linear → Settings → Account → Security & Access → Generate API key
# (lin_api_...). Sirve para headless: el MCP oficial remoto la acepta como
# Authorization: Bearer en https://mcp.linear.app/mcp — no requiere browser.
LINEAR_API_KEY=
# slug del workspace
LINEAR_WORKSPACE=your-workspace
# key human-readable del team
LINEAR_TEAM_KEY=ACM
# UUID del team (también va en projects/<slug>/project.json)
LINEAR_TEAM_ID=

# --- Notion (briefs, decisiones; opcional) ---
# Internal integration token: Notion → Settings → Connections → Develop →
# Create new integration (secret_... o ntn_...). El MCP oficial remoto lo
# acepta como Authorization: Bearer en https://mcp.notion.com/mcp.
NOTION_TOKEN=
# database ID (UUID) para briefs largos
NOTION_DATABASE_BRIEFS=
# database ID (UUID) para decisiones
NOTION_DATABASE_DECISIONS=

# =========================================================
# AI providers (para skills que necesiten llamadas LLM extra)
# Los agentes usan Anthropic por defecto. Las skills que necesiten cross-check
# con otros proveedores (ej. validar contra el modelo que usa el producto)
# pueden usar estos:
# =========================================================
OPENAI_API_KEY=
# Gemini: generación de imágenes del blog de Leda (scripts/leda-helpers.ps1). Si cada proyecto
# usa su propia key, va en .env.<slug>; si no, cópiala también ahí (es project-scoped).
GEMINI_API_KEY=

# =========================================================
# Alfred (meta-agente) — clon limpio del repo de agentes para abrir PRs
# =========================================================
# ej. ..\agent-team-template-alfred
ALFRED_REPO_PATH=
ALFRED_BASE_BRANCH=main

# =========================================================
# n8n
# =========================================================
N8N_WEBHOOK_BASE_URL=http://localhost:5678/webhook

# =========================================================
# Paths runtime
# =========================================================
QUEUE_DIR=./queue
AUDIT_DIR=./audit
MEMORY_DIR=./memory
