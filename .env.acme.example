# =========================================================
# .env.acme — secretos PROJECT-SCOPED del proyecto de ejemplo "Acme"
# =========================================================
# Template versionado; el real (.env.acme) está gitignored.
# Para un proyecto nuevo: copia este archivo a .env.<slug>.example (template) y a
# .env.<slug> (real) y completa los valores.
# Comentarios SIEMPRE en su propia línea: el loader de los wrappers no corta un "# …" al final
# de un valor, y lo exportaría como parte del valor.
#
# project.ps1 (Resolve-ProjectContext) limpia las vars project-scoped
# ($ProjectScopedVars) y carga este archivo ENCIMA de .env.server. Si agregas
# una var nueva aquí, agrégala también a $ProjectScopedVars en scripts/project.ps1.
# Una var con valor aquí PISA la de .env.server: no repitas lo que es core.
# Sin este archivo, los crons del proyecto corren sin sus secretos (el health
# check lo marca): no actives ningún workflow del proyecto antes de crearlo.
#
# Lo que QUEDA en .env.server (core, compartido entre proyectos):
# ANTHROPIC_API_KEY / ANTHROPIC_MODEL, LINEAR_API_KEY, CLAUDE_USERPROFILE,
# GH_TOKEN, DAILY_BUDGET_USD, PER_RUN_BUDGET_USD, VERCEL_API_TOKEN.

# --- Supabase (MCP read-only) ---
# your-project-ref
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=

# --- Google: GA4 + GSC (service account compartido) + API key (CWV) ---
# El path de la key va ABSOLUTO (el mismo de .env.server): al cargarse encima, un ./secrets/
# relativo que no existe en el server pisa el correcto y rompe los MCP de GA4, GSC y Google Ads.
# YOUR_GA4_PROPERTY_ID
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_JSON_PATH=./secrets/ga4-sa.json
GSC_SERVICE_ACCOUNT_JSON_PATH=./secrets/ga4-sa.json
GSC_SITE_URL=sc-domain:acme.example
# your-gcp-project
GOOGLE_PROJECT_ID=
GOOGLE_API=

# --- Google Ads (MCP oficial read-only) — sin secreto propio ---
# Reusa GA4_SERVICE_ACCOUNT_JSON_PATH (la service account tiene rol «Solo lectura» en la cuenta).
# El customer ID va en los overrides de Numa y Greta, no aquí. Solo si entras por una cuenta de
# administrador (MCC), completa el login customer ID. Ver docs/google-ads-readonly-source.md.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# --- Stripe (restricted key read-only) ---
# Si la cuenta de Stripe es compartida con otro negocio, la key ve todo: los agentes filtran por
# los productos/precios de este proyecto. Permisos mínimos: Read; nada de Write.
STRIPE_RESTRICTED_KEY=

# --- CMS de ejemplo: Payload + Gemini (Leda, ver scripts/leda-helpers.ps1) ---
# Base SIEMPRE con el host canónico (con www si el apex redirige: el redirect tira el header
# Authorization). El contrato de campos del pipeline vive en projects/acme/project.json → payload.
PAYLOAD_API_KEY=
PAYLOAD_BASE_URL=https://www.acme.example/api
# Gemini: la imagen destacada de cada nota del publisher de Leda.
GEMINI_API_KEY=

# --- Vercel (MCP read-only scripts/mcp-vercel) — NO cargues el token aquí ---
# El token (VERCEL_API_TOKEN) es de la cuenta y vive UNA vez en .env.server: project.ps1 lo
# conserva para cada proyecto. Los proyectos de Vercel que se pueden leer y el team están en
# projects/acme/project.json → vercel (son ids, no secretos). Un VERCEL_API_TOKEN con valor aquí
# pisa el de .env.server: úsalo solo si este proyecto vive en OTRA cuenta de Vercel (o con un
# token acotado a un proyecto). Detalle: docs/vercel-readonly-source.md.
VERCEL_API_TOKEN=

# --- Base MySQL del producto (MCP mysql read-only, scripts/mcp-mysql) — solo si no es Supabase ---
# Usuario con GRANT por columna, la base solo en 127.0.0.1 de la VM y un túnel SSH desde el server.
# El password lo pasa quien administra la base por un gestor de contraseñas. Si faltan las vars o
# el túnel está caído, el MCP responde "fuente MySQL no configurada" y Numa/Greta degradan.
# Requiere `npm ci` en scripts/mcp-mysql (una vez por máquina). Receta: docs/mysql-readonly-source.md.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=13306
MYSQL_DATABASE=
MYSQL_USER=agents_ro
MYSQL_PASSWORD=
# Segunda línea de defensa del guard: columnas que el GRANT ya no da pero que el guard rechaza
# antes de mandar la query (csv).
MYSQL_DENY_COLUMNS=name,email,message,domain,recipient,original_name
# Opcionales (vacío = default del MCP): tope de filas (500), timeout por query en ms (15000) y
# cierre de la conexión ociosa en ms (10000).
MYSQL_ROW_LIMIT=
MYSQL_TIMEOUT_MS=
MYSQL_IDLE_CLOSE_MS=
# Túnel SSH a la base (scripts\db-tunnel.ps1 -Project acme -Action …). Opcionales: si están vacíos,
# el script usa el bloque dbTunnel de projects/acme/project.json y después sus defaults
# (usuario agents-tunnel, puerto local 13306, remoto 3306; el host no tiene default).
DB_TUNNEL_HOST=
DB_TUNNEL_USER=
DB_TUNNEL_LOCAL_PORT=
DB_TUNNEL_REMOTE_PORT=

# --- Discord: pulso diario de Numa (skill funnel-daily-pulse, cron numa-daily-pulse) ---
# Webhook del canal (Discord → canal → Editar → Integraciones → Webhooks → Nuevo → Copiar URL).
# Lo postea scripts/run-skill.ps1 -DiscordWebhookVar DISCORD_WEBHOOK_NUMA. Si
# project.json → shippedDigestDiscordWebhookVar nombra esta var, el resumen semanal de Pico va al
# mismo canal. Es un secreto: quien tenga la URL puede postear en el canal.
DISCORD_WEBHOOK_NUMA=
