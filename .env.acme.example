# =========================================================
# .env.acme — secretos PROJECT-SCOPED del proyecto de ejemplo "Acme"
# =========================================================
# Template versionado; el real (.env.acme) está gitignored.
# Para un proyecto nuevo: copia este archivo a .env.<slug>.example (template) y a
# .env.<slug> (real) y completa los valores.
#
# project.ps1 (Resolve-ProjectContext) limpia las vars project-scoped
# ($ProjectScopedVars) y carga este archivo ENCIMA de .env.server. Si agregas
# una var nueva aquí, agrégala también a $ProjectScopedVars en scripts/project.ps1.
#
# Lo que QUEDA en .env.server (core, compartido entre proyectos):
# ANTHROPIC_API_KEY / ANTHROPIC_MODEL, LINEAR_API_KEY, CLAUDE_USERPROFILE,
# GH_TOKEN, DAILY_BUDGET_USD, PER_RUN_BUDGET_USD.

# --- Supabase (MCP read-only) ---
SUPABASE_PROJECT_REF=               # your-project-ref
SUPABASE_ACCESS_TOKEN=

# --- Google: GA4 + GSC (service account compartido) + API key (CWV) ---
GA4_PROPERTY_ID=                    # YOUR_GA4_PROPERTY_ID
GA4_SERVICE_ACCOUNT_JSON_PATH=./secrets/ga4-sa.json
GSC_SERVICE_ACCOUNT_JSON_PATH=./secrets/ga4-sa.json
GSC_SITE_URL=sc-domain:acme.example
GOOGLE_PROJECT_ID=                  # your-gcp-project
GOOGLE_API=

# --- Stripe (restricted key read-only) ---
STRIPE_RESTRICTED_KEY=

# --- CMS de ejemplo: Payload + Gemini (Leda, ver scripts/leda-helpers.ps1) ---
PAYLOAD_API_KEY=
PAYLOAD_BASE_URL=https://acme.example/api
GEMINI_API_KEY=

# --- Vercel (Qualy log-review) ---
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
